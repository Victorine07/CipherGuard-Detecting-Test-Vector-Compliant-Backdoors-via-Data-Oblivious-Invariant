{
  "description": "Vendored third-party lightweight-cipher implementations used by the conformance study (scripts/e11_conformance.py). Stored in-repo so the differential test is reproducible on an offline cluster node. Each is compared against our HOL-verified reference for the same cipher; the 'label' field is the anonymized name used in the paper.",
  "fetched": "2026-08-11",
  "license_note": "These files are third-party code retained for evaluation/reproducibility only. Verify each project's license before any public redistribution.",
  "implementations": [
    {
      "label": "inmcm-simon",
      "public_desc": "widely-used Simon/Speck library",
      "file": "impls/inmcm_simon.py",
      "cipher": "simon",
      "source": "https://github.com/inmcm/Simon_Speck_Ciphers",
      "adapter": {"kind": "class_ss", "cls": "SimonCipher"},
      "variants": ["simon_32_64","simon_48_72","simon_48_96","simon_64_96","simon_64_128","simon_96_96","simon_96_144","simon_128_128","simon_128_192","simon_128_256"],
      "expected": "conforming",
      "notes": "reference Python implementation of Simon"
    },
    {
      "label": "inmcm-speck",
      "public_desc": "widely-used Simon/Speck library",
      "file": "impls/inmcm_speck.py",
      "cipher": "speck",
