      "adapter": {"kind": "class_ss", "cls": "SpeckCipher"},
      "variants": ["speck_32_64","speck_48_72","speck_48_96","speck_64_96","speck_64_128","speck_96_96","speck_96_144","speck_128_128","speck_128_192","speck_128_256"],
      "expected": "conforming",
      "notes": "reference Python implementation of Speck"
    },
    {
